# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=flexikeys
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=flexikeys

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# ── Backend (mirrors backend/.env.example) ────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
DATABASE_URL=postgresql+asyncpg://flexikeys:CHANGE_ME@postgres:5432/flexikeys
REDIS_URL=redis://redis:6379/0
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=flexikeys
STORAGE_PUBLIC_URL=http://localhost:9000/flexikeys
LOG_LEVEL=INFO
AI_PROVIDER=stub

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# localhost variants for Flutter web/dev, 10.0.2.2 for Android emulator host loopback
CORS_ORIGINS=http://localhost,http://localhost:8080,http://localhost:5000,http://127.0.0.1,http://127.0.0.1:8080,http://10.0.2.2,http://10.0.2.2:8000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_DEFAULT=200/minute