# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
APP_DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://flexikeys:flexikeys@localhost:5432/flexikeys

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# RS256 is preferred in production; HS256 accepted in development only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Media / Storage ───────────────────────────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=flexikeys
STORAGE_PUBLIC_URL=http://localhost:9000/flexikeys

# ── AI Assistant ──────────────────────────────────────────────────────────────
# Set AI_PROVIDER=anthropic and AI_API_KEY to enable real parent-assistant
# replies (Anthropic Messages API). "openai" is accepted by config validation
# but has no provider implementation yet — selecting it silently falls back
# to the stub ("AI assistant is currently unavailable") just like leaving
# AI_PROVIDER=stub or AI_API_KEY empty.
AI_PROVIDER=stub             # stub | openai | anthropic
AI_API_KEY=                  # required when AI_PROVIDER=anthropic
AI_MODEL=                    # optional, defaults to claude-sonnet-4-6

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
SENTRY_DSN=                  # leave empty to disable

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=20/minute    # stricter for auth endpoints
RATE_LIMIT_DEFAULT=200/minute